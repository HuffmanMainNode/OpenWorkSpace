{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuffmanMainNode/OpenWorkSpace/blob/main/specifications/resource.schema.json",
  "title": "OpenWorkSpace Local Registry Record",
  "description": "Storage envelope for validated capability metadata; not an executable package record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_id", "version", "manifest_sha256", "registered_at"],
  "properties": {
    "capability_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registered_at": {"type": "string", "format": "date-time"}
  }
}
