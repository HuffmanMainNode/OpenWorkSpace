{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuffmanMainNode/OpenWorkSpace/blob/main/specifications/resource-packs.schema.json",
  "title": "OpenWorkSpace Curated Discovery Packs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_date",
    "catalog_path",
    "policy",
    "packs"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "const": "1.0"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "catalog_path": {
      "const": "catalog/first-party/repositories.json"
    },
    "policy": {
      "type": "string",
      "minLength": 20
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "purpose",
          "selection",
          "items",
          "access",
          "optional",
          "automatic_install",
          "automatic_execution",
          "security_approval",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "purpose": {
            "type": "string",
            "minLength": 20,
            "maxLength": 500
          },
          "selection": {
            "const": "curated-discovery"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project_id",
                "selection_reason"
              ],
              "properties": {
                "project_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
                },
                "selection_reason": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 300
                }
              }
            }
          },
          "access": {
            "const": "reference-only"
          },
          "optional": {
            "const": true
          },
          "automatic_install": {
            "const": false
          },
          "automatic_execution": {
            "const": false
          },
          "security_approval": {
            "const": false
          },
          "note": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  }
}
