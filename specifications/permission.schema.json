{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuffmanMainNode/OpenWorkSpace/blob/main/specifications/permission.schema.json",
  "title": "OpenWorkSpace Permission Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["principal", "resource", "action", "scope", "decision", "policy_reference"],
  "properties": {
    "principal": {"type": "string", "minLength": 1, "maxLength": 256},
    "resource": {"type": "string", "minLength": 1, "maxLength": 512},
    "action": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {"type": "string", "minLength": 1, "maxLength": 512},
    "decision": {"enum": ["allow", "deny"]},
    "policy_reference": {"type": "string", "minLength": 1, "maxLength": 512},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "reason": {"type": "string", "maxLength": 2000}
  }
}
