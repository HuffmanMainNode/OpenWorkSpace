{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuffmanMainNode/OpenWorkSpace/blob/main/specifications/contribution.schema.json",
  "title": "OpenWorkSpace Resource Contribution",
  "description": "A declarative proposal for a first-party or community resource. This record never authorizes installation or execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "summary", "origin", "publisher", "source", "license", "category", "maturity", "distribution", "execution", "permissions", "network", "review"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "name": {"type": "string", "minLength": 2, "maxLength": 120},
    "summary": {"type": "string", "minLength": 20, "maxLength": 500},
    "origin": {"enum": ["first-party", "community"]},
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "profile_url"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "profile_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "revision"],
      "properties": {
        "repository_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx_id", "redistribution_review"],
      "properties": {
        "spdx_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "redistribution_review": {"enum": ["not-reviewed", "allowed", "restricted", "not-allowed", "not-applicable"]}
      }
    },
    "category": {"enum": ["agent-foundations", "agent-coordination", "trust-security", "intelligence-research", "interoperability", "testing-evaluation", "storage-preservation", "developer-tools", "other"]},
    "maturity": {"enum": ["concept", "experimental", "pre-alpha", "alpha", "beta", "stable", "deprecated", "archived"]},
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source_included", "archive_allowed"],
      "properties": {
        "mode": {"enum": ["reference-only", "metadata-only", "source-link", "approved-archive"]},
        "source_included": {"type": "boolean"},
        "archive_allowed": {"type": "boolean"}
      }
    },
    "execution": {"enum": ["none", "manual", "external-process", "isolated-qualified"]},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"}},
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "destinations"],
      "properties": {
        "required": {"type": "boolean"},
        "destinations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 255}}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_at", "notes"],
      "properties": {
        "status": {"enum": ["proposed", "under-review", "approved-reference", "approved-archive", "rejected", "deferred", "revoked"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": "string", "maxLength": 2000}
      }
    },
    "upstream_notices": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
    "known_limitations": {"type": "array", "items": {"type": "string", "maxLength": 1000}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "distribution": {
            "properties": {
              "mode": {"const": "approved-archive"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "license": {
            "properties": {
              "redistribution_review": {"const": "allowed"}
            }
          },
          "distribution": {
            "properties": {
              "archive_allowed": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {"const": "isolated-qualified"}
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "status": {"enum": ["approved-reference", "approved-archive"]}
            }
          }
        }
      }
    }
  ]
}
