{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuffmanMainNode/OpenWorkSpace/blob/main/specifications/first-party-catalog.schema.json",
  "title": "OpenWorkSpace First-Party Resource Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_date",
    "discovery_method",
    "scope",
    "counts",
    "limitations",
    "repositories"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "const": "1.0"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "discovery_method": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accounts",
        "visibility",
        "forks_included",
        "private_repositories_included",
        "source_code_imported"
      ],
      "properties": {
        "accounts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PCakes303",
              "HuffmanRepositories",
              "HuffmanMainNode"
            ]
          }
        },
        "visibility": {
          "const": "public"
        },
        "forks_included": {
          "const": false
        },
        "private_repositories_included": {
          "const": false
        },
        "source_code_imported": {
          "const": false
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PCakes303",
        "HuffmanRepositories",
        "HuffmanMainNode",
        "total"
      ],
      "properties": {
        "PCakes303": {
          "type": "integer",
          "minimum": 0
        },
        "HuffmanRepositories": {
          "type": "integer",
          "minimum": 0
        },
        "HuffmanMainNode": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "publisher",
          "repository_url",
          "visibility",
          "fork",
          "resource_kind",
          "category",
          "summary",
          "declared_spdx_license",
          "license_review",
          "redistribution",
          "source_revision",
          "maturity",
          "review_state",
          "integration_mode",
          "automatic_install",
          "automatic_execution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "enum": [
              "PCakes303",
              "HuffmanRepositories",
              "HuffmanMainNode"
            ]
          },
          "repository_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/(PCakes303|HuffmanRepositories|HuffmanMainNode)/"
          },
          "visibility": {
            "const": "public"
          },
          "fork": {
            "const": false
          },
          "resource_kind": {
            "enum": [
              "tool",
              "protocol",
              "specification",
              "fixtures",
              "library",
              "integration",
              "runtime",
              "resource-library",
              "ecosystem-index",
              "research",
              "archive",
              "profile",
              "roadmap"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 10
          },
          "declared_spdx_license": {
            "type": [
              "string",
              "null"
            ]
          },
          "license_review": {
            "enum": [
              "not-established",
              "not-reviewed",
              "reviewed"
            ]
          },
          "redistribution": {
            "const": "not-approved"
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "maturity": {
            "enum": [
              "not-assessed",
              "not-applicable",
              "concept",
              "experimental",
              "pre-alpha",
              "alpha",
              "beta",
              "stable",
              "deprecated",
              "archived"
            ]
          },
          "review_state": {
            "enum": [
              "metadata-reviewed",
              "readme-reviewed"
            ]
          },
          "integration_mode": {
            "const": "reference-only"
          },
          "automatic_install": {
            "const": false
          },
          "automatic_execution": {
            "const": false
          }
        }
      }
    }
  }
}
